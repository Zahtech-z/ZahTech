# Required for the contact form. Create this in the Resend dashboard.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Required. Use an approved sender address on a domain verified in Resend.
# Placeholder only: do not assume this domain or address is already verified.
CONTACT_FROM_EMAIL=ZahTech Website <noreply@your-verified-domain.example>
# Controls the ZahTech inbox that receives project inquiries.
# The application falls back to contact@zahtech.net when this is not configured.
CONTACT_TO_EMAIL=contact@zahtech.net
